{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "Fetchr beta v0.8.9",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "fullscreen": false,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../yt-dlp": "resources/yt-dlp",
      "../N_m3u8DL-RE": "resources/N_m3u8DL-RE"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
