# Copy to build.env (git-ignored) and fill in. Read by Build.bat and
# BuildInstaller.bat. CI takes the same values from repository secrets.
# Plain KEY=VALUE, no quotes, no spaces around the "=".

# Twitch-unflagged proxy for the gql+usher master-playlist request only.
# Format: http://user:pass@ip:port or socks5://user:pass@ip:port
FETCHR_TWITCH_RESOLVER=

# VPS recorder API. Must be https:// - the token travels in the X-Token header.
FETCHR_VPS_BASE_URL=
FETCHR_VPS_TOKEN=

# Public half of the release signing key (base64, 32 bytes). Not a secret, but it
# MUST match the key that signs latest-update.json, or clients refuse every update.
# BuildInstaller.bat refuses to build without it: an installer shipped without a
# matching key pair can never install another update, and that cannot be fixed
# remotely afterwards.
FETCHR_UPDATE_PUBKEY=

# Private half. This one IS a secret - keep it in a password manager, never on the
# VPS. This file is line-based, so put the PEM on ONE line with literal \n instead
# of real line breaks:
#   FETCHR_UPDATE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQ...\n-----END PRIVATE KEY-----  (secret-scan: allow)
# Alternatively export it in the shell before running BuildInstaller.bat and leave
# this empty.
FETCHR_UPDATE_PRIVATE_KEY=
